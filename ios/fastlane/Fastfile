require "json"
require "shellwords"
def load_asc_api_key
  path = File.expand_path("~/.appstoreconnect/asc_api_key.json")
  UI.user_error!("Missing #{path}") unless File.exist?(path)
  k = JSON.parse(File.read(path))
  app_store_connect_api_key(key_id: k["key_id"], issuer_id: k["issuer_id"],
                            key_filepath: k["key_filepath"], in_house: false)
end
default_platform(:ios)
platform :ios do
  before_all { load_asc_api_key }
  # Run `flutter build ios --release --no-codesign` BEFORE this lane.
  lane :build_release do
    k = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/asc_api_key.json")))
    auth = ["-allowProvisioningUpdates",
      "-authenticationKeyPath #{k['key_filepath'].shellescape}",
      "-authenticationKeyID #{k['key_id']}",
      "-authenticationKeyIssuerID #{k['issuer_id']}"].join(" ")
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner",
      configuration: "Release", export_method: "app-store", xcargs: auth,
      output_directory: File.expand_path("../build/ios/ipa", __dir__),
      output_name: "liftly.ipa", clean: false)
  end
  lane :tf_upload do
    upload_to_testflight(ipa: File.expand_path("../build/ios/ipa/liftly.ipa", __dir__),
      skip_waiting_for_build_processing: true, skip_submission: true)
  end
end
